# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_PATH=./data/catandary.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/catandary

# Optional APIs
# EXPLODING_TOPICS_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=

# Trend-Radar (paid product)
PORTAL_BASE_URL=http://localhost:3001
# RESEND_API_KEY=
BRIEFING_FROM="Catandary Trend-Radar <radar@catandary.de>"
BRIEFING_OUTBOX=./data/briefing_outbox
# Frontend (frontend/.env.local): Stripe payment links for the landing page
# NEXT_PUBLIC_STRIPE_LINK_SOLO=
# NEXT_PUBLIC_STRIPE_LINK_PRO=

# Logging
LOG_LEVEL=INFO
