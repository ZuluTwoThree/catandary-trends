# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_PATH=./data/catandary.db
# PostgreSQL (production since 2026-07-03; empty = SQLite fallback)
DATABASE_URL=postgresql:///catandary

# Optional APIs
# EXPLODING_TOPICS_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
# FIRECRAWL_API_KEY=   # LEGACY, seit 2026-09-06 widerrufen — nur scripts/backfill_sources.py --mode deep
#                       und scripts/deep_uncapped_measure.py; beide durch WP-API/OpenAlex abgeloest.

# Anthropic API — classification backend for the one-time historical backfill.
# Set CLASSIFY_BACKEND=anthropic to route Stages 2/3/4/8 to Claude (off-GPU);
# embeddings + content-gen stay local. The ongoing RSS pipeline stays local.
CLASSIFY_BACKEND=ollama          # ollama | llamacpp | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5

# Logging
LOG_LEVEL=INFO

# OpenAlex free API key (openalex.org/settings/api) — seit 2026-02 usage-based:
# ohne Key 1.000 Credits/Tag/IP, mit kostenlosem Key $1/Tag = 10.000 Listen-Calls
OPENALEX_API_KEY=

# EPO Open Patent Services (free OAuth app: developers.epo.org) -- patent signals
# (title + abstract + CPC + date) for scripts/ingest_patents.py. Free throttled tier.
# Consumer key/secret = the OPS *app* credentials (client_credentials grant).
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET_KEY=

# EPO *account* login (your developers.epo.org username/password) -- used by the
# EPO BDDS bulk service (password grant via login.epo.org), NOT the OPS app key.
# Enables bulk EP DocDB downloads without OPS rate limits. Quote the password if
# it contains $, # or spaces.
EPO_LOGIN=
EPO_PASSWORD=

# --- App base / signing ---
# (Magic-link auth, tiers and Stripe were removed 2026-09-03 — no SaaS, #93.
#  AUTH_ENABLED / PAYWALL_ENABLED / EMAIL_TRANSPORT / STRIPE_* are gone.)
AUTH_SECRET=                   # openssl rand -hex 32 — signs the newsletter unsubscribe tokens (lib/unsubscribe.ts, >= 16 chars or tokens fail closed)
PUBLIC_BASE_URL=http://localhost:3004   # app origin: same-origin check on POST routes (lib/apiGuards.ts) + newsletter links

# --- Newsletter delivery (#16) — pipeline/newsletter_sender.py ---
RESEND_API_KEY=                # send-only key; verified sending domain send.catandary.de
NEWSLETTER_FROM=Catandary Trends <trends@send.catandary.de>
# Unsubscribe (owner decision 2026-09-02: the public site is a static export, so
# the withdrawal link in every mail is the PHP endpoint on the webspace,
# docs/launch/newsletter-doi-php/unsubscribe.php — NOT the Next route).
NEWSLETTER_PUBLIC_BASE=https://catandary.de   # where /newsletter/unsubscribe.php lives
NEWSLETTER_UNSUB_SECRET=       # openssl rand -hex 32 — MUST equal unsub_secret (block 5) in nl_config.php
NEWSLETTER_UNSUB_MAILTO=contact@catandary.de  # mailto: half of the List-Unsubscribe header
# Subscriber bridge Hetzner-MySQL -> local Postgres (sync_subscribers.py)
NL_EXPORT_URL=https://catandary.de/newsletter/export.php
NL_EXPORT_TOKEN=               # = export_token (block 6) in nl_config.php
# --- Sales contact (sales-led, no checkout — #93) ---
# The enquiry page (/enquiry, exported as /trends/enquiry) offers a mailto: to
# this address for Super Pro+ and individual analyses.
CONTACT_EMAIL=trends@catandary.de

# --- Public deployment gate (issue #93 Etappe 1) ---
# 1 = the instance 404s the Foresight tool suite (/trends/foresight/* +
# /api/foresight/*) and the two internal review pages (/trends/review,
# /trends/quality-preview) and windows the feed to PUBLIC_WINDOW_DAYS — the
# workstation preview of the public static export (:3999). 0/unset (owner
# instance on :3001/:3004) changes nothing.
PUBLIC_MODE=0

# --- Reverse-proxy trust (security review 2026-09-02, E-3) ---
# 1 = the Next app runs behind a proxy we control (Caddy) and the per-IP rate
# limiters may read X-Forwarded-For / X-Real-IP (last TRUSTED_PROXY_COUNT hops,
# default 1, are ours). 0/unset = headers are ignored — every direct caller
# shares one limiter bucket. Never set 1 on an instance reachable without the
# proxy: the headers are then attacker-controlled and every limit is bypassable.
TRUST_PROXY=0
# TRUSTED_PROXY_COUNT=1

# --- Static export → webspace publish (scripts/publish_static_site.py) ---
# The SFTP/rsync credentials for catandary.de do NOT live here: they are read
# from ~/.config/catandary/webspace.env (KEY=VALUE, chmod 600 — MODE, HOST,
# PORT, USER, PASSWORD|KEY_FILE, REMOTE_ROOT, CONNECTIONS, HOST_KEY_POLICY;
# format in the script docstring and docs/launch/HOSTING_HETZNER.md).
# Optional override of that path (also honoured by scripts/publish_static_site.sh):
# PUBLISH_CONFIG=~/.config/catandary/webspace.env

# --- Owner dossier desk (#95, docs/agentic_dossiers.md) ---
# /trends/dossiers (order slips, reports, "Neu rechnen") is part of the owner
# app and ON by default. DOSSIERS_ENABLED=0 is the emergency-off switch (404).
# The route never exists on the public side: PUBLIC_MODE=1 blocks it in proxy.ts
# and frontend/static-export.exclude keeps it out of the static export.
# Tables: run scripts/migrate_dossier_orders.py once by hand (additive).
# DOSSIERS_ENABLED=0

# Eigener Embedding-Endpunkt fuer die Vektorsuche des Korpus-Rechercheurs (#97).
# Waehrend ein Dossier laeuft, haelt :8090 den 27B — ein Embedding-Request dorthin
# kaeme vom Chatmodell. Der CPU-Server (systemd catandary-embed-cpu.service,
# ~/llama.cpp/start-qwen3-emb-cpu.sh) belegt kein VRAM. Leer = Volltextsuche.
RESEARCH_EMBED_HOST=http://127.0.0.1:8091

# Fremde GPU im Tailnet (optional). Leer = nur die lokale Karte.
# Fenster in lokaler Zeit, ueber Mitternacht erlaubt ("22:00-06:00").
# Ausserhalb des Fensters ODER bei nicht erreichbarem Host faellt jeder
# Aufrufer auf die lokale GPU zurueck — der Rechner ist ein Arbeitsplatz,
# kein Server.
REMOTE_EMBED_HOST=
REMOTE_GPU_WINDOW=01:00-17:00
REMOTE_EMBED_MODEL=qwen3-embedding
