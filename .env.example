# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_PATH=./data/catandary.db
# PostgreSQL (production since 2026-07-03; empty = SQLite fallback)
DATABASE_URL=postgresql:///catandary

# Optional APIs
# EXPLODING_TOPICS_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=

# Anthropic API — classification backend for the one-time historical backfill.
# Set CLASSIFY_BACKEND=anthropic to route Stages 2/3/4/8 to Claude (off-GPU);
# embeddings + content-gen stay local. The ongoing RSS pipeline stays local.
CLASSIFY_BACKEND=ollama          # ollama | llamacpp | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5

# Logging
LOG_LEVEL=INFO

# OpenAlex free API key (openalex.org/settings/api) — seit 2026-02 usage-based:
# ohne Key 1.000 Credits/Tag/IP, mit kostenlosem Key $1/Tag = 10.000 Listen-Calls
OPENALEX_API_KEY=

# EPO Open Patent Services (free OAuth app: developers.epo.org) -- patent signals
# (title + abstract + CPC + date) for scripts/ingest_patents.py. Free throttled tier.
# Consumer key/secret = the OPS *app* credentials (client_credentials grant).
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET_KEY=

# EPO *account* login (your developers.epo.org username/password) -- used by the
# EPO BDDS bulk service (password grant via login.epo.org), NOT the OPS app key.
# Enables bulk EP DocDB downloads without OPS rate limits. Quote the password if
# it contains $, # or spaces.
EPO_LOGIN=
EPO_PASSWORD=

# --- Accounts / auth (Epic W2.1, issue #17) ---
AUTH_ENABLED=0                 # 1 to expose the sign-in/account surface
AUTH_SECRET=                   # openssl rand -hex 32 — signs session cookies
EMAIL_TRANSPORT=console        # console (logs link) | resend (needs verified domain)
PUBLIC_BASE_URL=http://localhost:3004
# RESEND_API_KEY / NEWSLETTER_FROM shared with the newsletter sender
# --- Stripe (Epic W2.3, test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ids for the 3 monthly subscription tiers (owner pricing 2026-07-19:
# Starter €99/mo, Pro €499/mo, Super Pro+ €799/mo). Amounts live in the Price
# objects, not in code — set the ids here when going live.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SUPERPRO=
PAYWALL_ENABLED=0
# Hypercare (Trend & Foresight) is sales-led / day-rate, NOT a subscription — no
# Stripe price. The pricing page shows a "talk to us" mailto to this address.
CONTACT_EMAIL=trends@catandary.de

# --- Public deployment gate (issue #93 Etappe 1) ---
# 1 = the deployed instance 404s the Foresight tool suite (/trends/foresight/*
# + /api/foresight/*), accounts (/account*, /api/auth/*), Stripe checkout
# (/api/stripe/*) and the two internal review pages (/trends/review,
# /trends/quality-preview) — the public site becomes a free lead-gen
# showcase, the tools stay workstation-only. 0/unset (today's workstation
# instance on :3001) changes nothing.
PUBLIC_MODE=0

# --- Reverse-proxy trust (security review 2026-09-02, E-3) ---
# 1 = the Next app runs behind a proxy we control (Caddy) and the per-IP rate
# limiters may read X-Forwarded-For / X-Real-IP (last TRUSTED_PROXY_COUNT hops,
# default 1, are ours). 0/unset = headers are ignored — every direct caller
# shares one limiter bucket. Never set 1 on an instance reachable without the
# proxy: the headers are then attacker-controlled and every limit is bypassable.
TRUST_PROXY=0
# TRUSTED_PROXY_COUNT=1
