# Catandary public site — static export of the Next.js app.
# Copied to the export root by scripts/build_public_static.sh (Schritt 7 of
# docs/audits/2026-09-02_static_export_design.md). Apache 2.4, Hetzner shared
# webhosting (mod_rewrite + mod_headers are what the DOI package already uses).
#
# Layout the export produces (trailingSlash: false):
#   /trends/<slug>.html           the page
#   /trends/<slug>.txt            RSC payload for client-side navigation
#   /trends/<slug>/__next.*.txt   segment-prefetch payloads (a DIRECTORY of
#                                 the same name as the page — see DirectorySlash)
#   /_next/static/<buildid|hash>  content-addressed JS/CSS/fonts
#   /404.html, /trends/expired.html, /sitemap.xml, /robots.txt
#   /opengraph-image, /icon       extensionless PNGs

Options -Indexes
AddDefaultCharset UTF-8

# Next writes BOTH /trends/<slug>.html and a /trends/<slug>/ directory. With
# the default DirectorySlash On, mod_dir answers /trends/<slug> with a 301 to
# /trends/<slug>/ before the rewrite below can map it to the .html file — so
# the slash redirect is switched off and rule 2 sends slash URLs back instead.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Extensionless page URL -> its .html file. Covers /trends, /trends/<slug>,
  #    /trends/mega/<key>, /imprint, ... URLs stay identical to the app.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 2. Trailing-slash form of a page (/trends/<slug>/) -> canonical URL.
  #    Without this, DirectorySlash Off + Options -Indexes would answer 403.
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{DOCUMENT_ROOT}%1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 3. Expired article: every article slug ends in -<numeric id>. A URL of
  #    that shape with no file behind it rolled out of the public window
  #    (~590/day) -> 410 Gone with the branded page (ErrorDocument below).
  #    Pattern-based on purpose: no 15k-line redirect map to maintain.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
  RewriteRule ^trends/[a-z0-9-]+-[0-9]+$ - [G,L]

  # 4. Legacy vertical route (a redirect-only page in the app, not exported).
  #    Until the static listing routes of Schritt 4 exist, land on the feed.
  RewriteRule ^trends/vertical/[A-Za-z]+/?$ /trends [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 410 /trends/expired.html

# Metadata image routes are extensionless files; without a type Apache
# serves them as application/octet-stream and social cards stay blank.
<Files "opengraph-image">
  ForceType image/png
</Files>
<Files "icon">
  ForceType image/png
</Files>
# NB: the .txt RSC payloads are fine as text/plain — Next's router accepts
# text/plain for output:"export" builds (fetch-server-response.js).

<IfModule mod_headers.c>
  # Mirror of SECURITY_HEADERS in next.config.ts (headers() cannot ship in
  # an export).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"

  # Content-addressed assets: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages, RSC payloads, sitemap: revalidate on every visit (the site is
  # rebuilt daily; ETag/Last-Modified make the revalidation cheap).
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Pre-launch: robots.txt + <meta name="robots"> already say noindex when the
  # export was built with PUBLIC_NOINDEX=1. Belt-and-braces header, if wanted:
  # Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# TEST PLAN on the Hetzner webspace (no Apache on the workstation — the rules
# above are unverified until this list is green; run after the first upload):
#
#   curl -sI https://catandary.de/trends/<slug>            -> 200, text/html
#   curl -sI https://catandary.de/trends/<slug>/           -> 301 Location: /trends/<slug>
#   curl -sI https://catandary.de/trends/<slug>.txt        -> 200, text/plain
#   curl -sI https://catandary.de/trends/<slug>/__next._tree.txt -> 200 (segment payload)
#   curl -sI https://catandary.de/trends                   -> 200 (NOT 301 to /trends/)
#   curl -sI https://catandary.de/trends/mega/<key>        -> 200
#   curl -sI https://catandary.de/trends/does-not-exist-123 -> 410, body = expired page
#   curl -sI https://catandary.de/trends/does-not-exist    -> 404, body = 404.html
#   curl -sI https://catandary.de/nope                     -> 404
#   curl -sI https://catandary.de/trends/vertical/tech     -> 301 -> /trends
#   curl -sI https://catandary.de/opengraph-image          -> 200, image/png
#   curl -sI https://catandary.de/_next/static/catandary/_buildManifest.js
#                                                           -> Cache-Control immutable
#   curl -sI https://catandary.de/trends/<slug>            -> Cache-Control: no-cache,
#                                                              X-Frame-Options: DENY
#   curl -s  https://catandary.de/_next/                   -> 403/404, no listing
#   Browser: /trends -> click a card -> URL changes without full reload
#            (client navigation via the .txt payload); reload -> same page.
#   If ANY rule 500s: "AllowOverride" on the webspace may not include
#   Options/FileInfo — drop `Options -Indexes` first, then `DirectorySlash`.
# ---------------------------------------------------------------------------
