# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
# Auch als Symlink ignorieren: ein Worktree teilt die venv des Haupt-Checkouts,
# und '.venv/' mit Schraegstrich greift nur bei echten Verzeichnissen.
.venv
.env
env/

# Environment
.env

# Database
*.db
*.sqlite3

# Local data artifacts
data/

# Node / Next.js
node_modules/
.next/
.next-public/
out/
# next-env.d.ts is regenerated by `next dev`/`next build` with a mode-
# dependent import path — keeping it tracked produces working-tree noise
# every time the mode flips. Regenerated on first build after clone.
frontend/next-env.d.ts

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test
.pytest_cache/
htmlcov/
.coverage

# Local review artifacts
prompts_for_review.txt

20*-this-session-*.txt

# trained distillation heads (reproducible via scripts/train_distill_heads.py)
models/

# Reference PDFs (blueprints, CPC documentation) — local only
pdf/

# env files (secrets)
.env*
!.env.example

# Field Watch: Kundenfelder bleiben lokal (nur example.yaml im Repo)
fields/*.yaml
!fields/example*.yaml
