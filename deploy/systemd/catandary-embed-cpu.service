[Unit]
# Eigener Embedding-Server auf der CPU, Port 8091 (#97, 2026-09-09).
#
# Warum getrennt: waehrend :8090 ein Chatmodell haelt (Draft-Richter, Content-
# Gen), wuerde ein Embedding-Request dorthin vom Chatmodell beantwortet — die
# Vektorsuche liefe gegen einen Vektor aus einem anderen Raum. Auf der 24-GB-
# Karte koennen beide nicht resident sein, deshalb CPU (CUDA_VISIBLE_DEVICES=""
# im Startskript). Kostet ~5 GB RAM, 0 MiB VRAM; eine Anfrage ~0,3 s.
# Urspruenglicher Nutzer war der Korpus-Rechercheur der Scouting-Dossiers
# (Feature entfernt 2026-09-19); heute nutzt ihn u. a. scripts/validate_emerging.py
# (RESEARCH_EMBED_HOST).
Description=Catandary embedding server (CPU, port 8091) for vector retrieval off the GPU
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/dirk/llama.cpp
ExecStart=/home/dirk/llama.cpp/start-qwen3-emb-cpu.sh
# Restart=always statt on-failure: der Dienst soll immer stehen. Am 10.09. hat
# ihn der VRAM-Cleanup des Nachtlaufs per SIGTERM erwischt (pkill -f
# build/bin/llama-server) und systemd wertete das nicht als Fehler — er lag
# danach still da. Der Cleanup verschont ihn seitdem, aber ein Dienst ohne
# eigenen Zustand darf auch grundlos neu starten.
Restart=always
RestartSec=10
TimeoutStopSec=20
KillMode=mixed
StandardOutput=append:/tmp/llama-embed-cpu.log
StandardError=append:/tmp/llama-embed-cpu.log

[Install]
WantedBy=default.target
