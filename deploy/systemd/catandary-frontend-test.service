[Unit]
Description=Catandary Trends frontend (test, port 3002) — enable on demand, not at boot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/dirk/projects/catandary-trends/frontend
Environment=PATH=/home/dirk/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/home/dirk/projects/catandary-trends/frontend/node_modules/.bin/next start -p 3002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
