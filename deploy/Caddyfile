catandary.de {
    # Next.js frontend
    handle /trends* {
        reverse_proxy localhost:3001
    }

    # API routes
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # Sitemap and robots
    handle /sitemap.xml {
        reverse_proxy localhost:3001
    }
    handle /robots.txt {
        reverse_proxy localhost:3001
    }

    # Static assets with long cache
    handle /_next/static/* {
        reverse_proxy localhost:3001
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Root redirect to trends
    handle / {
        redir /trends permanent
    }
}
